{
  "name": "@atlas/ai-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Atlas Studio FastAPI AI worker",
  "scripts": {
    "dev": "node scripts/run-python.mjs -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
    "start": "node scripts/run-python.mjs -m uvicorn app.main:app --host 0.0.0.0 --port 8000",
    "build": "node scripts/run-python.mjs -m compileall -q app cypy",
    "typecheck": "node scripts/run-python.mjs -m compileall -q app cypy",
    "test": "node scripts/run-python.mjs -m unittest discover -s tests -p 'test_*.py'"
  }
}
