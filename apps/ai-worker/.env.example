# OpenRouter is used only by the AI worker. Never expose this key to the browser.
OPENROUTER_API_KEY=

# Optional OpenRouter attribution headers.
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_APP_TITLE=Atlas Studio

# Image localization makes one translated-image and one clean-image request.
OPENROUTER_IMAGE_TIMEOUT_SECONDS=240
