# OpenRouter is used only by the AI worker. Never expose this key to the browser.
OPENROUTER_API_KEY=

# Optional OpenRouter attribution headers.
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_APP_TITLE=Atlas Studio

# Image localization makes one translated-image and one clean-image request.
OPENROUTER_IMAGE_TIMEOUT_SECONDS=240

# The direct Gemini editor option bypasses OpenRouter entirely.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
MODEL_GEMINI=gemini-3.1-flash-lite-image
GEMINI_IMAGE_TIMEOUT_SECONDS=240

# Local comic text and bubble detection. The verified INT8 ONNX model is
# downloaded from Hugging Face on the first detection and cached locally.
DETECTION_PROVIDER=huggingface_comic
COMIC_DETECTOR_REPOSITORY=ogkalu/comic-text-and-bubble-detector
COMIC_DETECTOR_REVISION=16e8a622f91fabc6b5b65c96d32d1183f8843546
COMIC_DETECTOR_FILENAME=detector-v4-s_int8.onnx
COMIC_DETECTOR_SHA256=5fe9e4f576e49d4e7e8b0e029d6d3cdc252abd4694113e1cae120e62c931ea79
COMIC_DETECTOR_CONFIDENCE=0.3
COMIC_DETECTOR_LABELS=bubble,text_bubble,text_free
COMIC_DETECTOR_DOWNLOAD_TIMEOUT_SECONDS=300
ENABLE_LEGACY_DETECTION_FALLBACK=false

# Optional absolute path for an existing verified model file.
# COMIC_DETECTOR_MODEL_PATH=
